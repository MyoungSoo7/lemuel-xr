# JVM
backend/build/
backend/.gradle/
*.iml
.idea/

# Python
# 디렉터리별로 적으면 새 파이썬 디렉터리가 생길 때마다 .pyc 가 커밋된다 —
# scripts/__pycache__/newchar_gates.cpython-314.pyc 가 실제로 그렇게 들어왔다.
__pycache__/
*.pyc
tts/__pycache__/
ai/__pycache__/
ai/.pytest_cache/
tts/*.egg-info/
tts/.venv/

# Unity (예정)
unity/Library/
unity/Temp/
unity/Logs/
unity/Builds/
unity/UserSettings/

# Secrets
**/.env
!**/.env.example
*.pem
*.key

# Reviewer bootstrap — 자문가 PII 보호 (REVIEWER-BOOTSTRAP.md §6 PII 보호)
# .example 만 git 에 체크인, 실제 application-bootstrap.yml 은 K8s Secret 또는
# 로컬 마운트로 주입.
backend/src/main/resources/application-bootstrap.yml
!backend/src/main/resources/application-bootstrap.yml.example
